{
  "name": "neo-cli-agent",
  "version": "0.1.3",
  "description": "Multi-API cache-first coding agent with auto model switching",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "neo": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuwentian300-sketch/Neo-Cli--cli.git"
  },
  "homepage": "https://github.com/chuwentian300-sketch/Neo-Cli--cli",
  "keywords": [
    "cli",
    "agent",
    "coding",
    "ai",
    "deepseek",
    "openai",
    "claude",
    "cache"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8",
    "undici": "^7.4.0",
    "eventsource-parser": "^3.0.0",
    "chalk": "^5.4.1",
    "signal-exit": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.4",
    "@types/node": "^22.10.2"
  }
}
